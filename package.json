{
  "name": "agent-os",
  "version": "0.1.0",
  "description": "Agent OS — 你的个人生产系统（《Agent OS 个人生产系统实战》配套项目）",
  "type": "module",
  "scripts": {
    "dev": "pnpm start",
    "start": "tsx watch --include .env --include \"config/*.json\" src/index.ts",
    "start:once": "tsx src/index.ts",
    "probe": "tsx src/probe-lark.ts",
    "build": "tsc",
    "probe:cli": "tsx src/probe-cli.ts",
    "probe:tool": "tsx src/probe-app-tool.ts",
    "start:prod": "node dist/index.js",
    "agent-os": "tsx src/deploy-cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
